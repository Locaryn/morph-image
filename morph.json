{
  "$schema": "https://locaryn.dev/schema/morph.json/v0.1",
  "apiVersion": "0.1",
  "name": "morph-image",
  "version": "3.1.0-beta.1",
  "description": "Extension autonome d'image : génération, img2img et retouche ciblée par masque, avec son moteur stable-diffusion.cpp, ses modèles et son interface.",
  "author": "Locaryn Team",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Locaryn/morph-image",
  "repository": "https://github.com/Locaryn/morph-image",
  "keywords": [
    "image-generation",
    "image-editing",
    "stable-diffusion",
    "flux",
    "z-image",
    "text-to-image"
  ],
  "permissions": {
    "mcp": {
      "reason": "Lancer le moteur image local fourni par l'extension."
    },
    "files.read": {
      "reason": "Lire les modèles et les images source du stockage de l'extension."
    },
    "files.write": {
      "reason": "Écrire les modèles téléchargés, le runtime et les images produites par l'extension."
    },
    "network": {
      "reason": "Télécharger les modèles et les runtimes depuis leurs sources HTTPS."
    }
  },
  "components": {
    "skills": [
      "SKILL.md"
    ],
    "mcp": "mcp/mcp.json"
  },
  "capabilities": [
    "image-gen",
    "image-editor"
  ],
  "ui_contributions": {
    "slots": [
      {
        "id": "image-catalog",
        "slot": "marketplace.catalogs",
        "order": 10,
        "type": "data",
        "label": "Modèles de génération d'image",
        "icon": "image",
        "entry": "dist/marketplace.json",
        "hint": "Ajoute le filtre « Génération d'image » et ses modèles au catalogue"
      },
      {
        "id": "image-studio",
        "slot": "studio.tabs",
        "order": 10,
        "label": "Génération d'image",
        "icon": "image",
        "type": "custom-element",
        "entry": "dist/ui.js",
        "tag": "locaryn-image-panel",
        "hint": "Génération et retouche locales dans l'extension image"
      }
    ],
    "nav_items": [
      {
        "id": "studio",
        "label": "Studio de génération",
        "icon": "image"
      }
    ]
  },
  "beta": true,
  "stability": "untested",
  "versions": [
    {
      "version": "3.1.0-beta.1",
      "is_beta": true,
      "summary": "Version Bêta (3.1.0-beta.1) — pre-release non testée par des utilisateurs",
      "tag": "v3.1.0-beta.1",
      "released_at": "2026-08-29",
      "install_source": "Locaryn/morph-image#v3.1.0-beta.1"
    },
    {
      "version": "3.0.0",
      "is_beta": false,
      "summary": "Version stable de référence v3.0.0",
      "tag": "v3.0.0",
      "released_at": "2026-08-27",
      "install_source": "Locaryn/morph-image#v3.0.0"
    },
    {
      "version": "2.2.0",
      "is_beta": false,
      "summary": "Version stable de référence v2.2.0",
      "tag": "v2.2.0",
      "released_at": "2026-08-27",
      "install_source": "Locaryn/morph-image#v2.2.0"
    },
    {
      "version": "2.1.0",
      "is_beta": false,
      "summary": "Version stable de référence v2.1.0",
      "tag": "v2.1.0",
      "released_at": "2026-08-27",
      "install_source": "Locaryn/morph-image#v2.1.0"
    }
  ]
}
